{
  "auto_promocao": {
    "ligada": true,
    "so_acoes_de_criar": true,
    "limite_de_regras": 6
  },
  "mundo": {
    "ligado": true,
    "relatorio_em": "relatorios/inventario-desktop.txt",
    "permitido": ["ler", "contar", "escrever_dentro_do_projeto"],
    "proibido": ["mover", "apagar", "editar_arquivo_do_mundo"],
    "so_quando_mudar": true
  },
  "execucao": {
    "ligada": true,
    "so_com_humano": true,
    "timeout": 15,
    "teto_saida": 4000,
    "permitidas": [
      "git status",
      "git log --oneline -5",
      "python --version",
      "pip list"
    ]
  },
  "acoes": [
    {
      "id": "criar_arquivo_base",
      "pasta_com_conteudo": [".gitkeep"],
      "criar_arquivo": "base.py",
      "conteudo": "# EU MUDEI SO O TEXTO DO JSON E O AGENTE OBEDECEU\n"
    },
    {
      "id": "avisar_sobre_config",
      "pasta_com_conteudo": [".gitkeep", "base.py"],
      "criar_arquivo": "LEIA-ME.txt",
      "conteudo": "# NAO APAGUE base.py em config: ele e gerado pelo agente. Veja memoria/historico.json\n"
    }
  ]
}