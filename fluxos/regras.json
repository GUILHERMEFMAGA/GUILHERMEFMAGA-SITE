{
  "auto_promocao": {
    "ligada": true,
    "so_acoes_de_criar": true,
    "limite_de_regras": 6
  },
  "mundo": {
    "ligado": true,
    "relatorio_em": "relatorios/inventario-desktop.txt",
    "permitido": ["ler", "contar", "escrever_dentro_do_projeto"],
    "proibido": ["mover", "apagar", "editar_arquivo_do_mundo"],
    "so_quando_mudar": true,
    "olhos": [
      {"nome": "desktop", "relatorio_em": "relatorios/inventario-desktop.txt"},
      {"nome": "downloads", "relatorio_em": "relatorios/inventario-downloads.txt"}
    ]
  },
  "execucao": {
    "ligada": true,
    "so_com_humano": true,
    "timeout": 15,
    "teto_saida": 4000,
    "permitidas": [
      "git status",
      "git log --oneline -5",
      "python --version",
      "pip list"
    ]
  },
  "abrir": {
    "ligado": true,
    "raizes": ["projeto", "desktop", "downloads"],
    "jamais_abrir": [".exe", ".bat", ".cmd", ".ps1", ".psm1", ".vbs", ".vbe", ".js", ".jse", ".wsf", ".wsh", ".msi", ".msp", ".scr", ".com", ".pif", ".lnk", ".url", ".reg", ".hta", ".cpl"]
  },
  "vigilia": {
    "ligado": true,
    "tolerancia_seg": 30,
    "max_eventos": 25,
    "olhos": [
      {"pasta": "downloads", "ao_chegar": ["inventario", {"anotar": "chegou arquivo novo"}, {"anotar_fila": "avisar:o porteiro viu novidade no Downloads — olhe o inventario"}]},
      {"pasta": "desktop", "ao_chegar": ["inventario"]}
    ]
  },
  "acoes": [
    {
      "id": "criar_arquivo_base",
      "pasta_com_conteudo": [".gitkeep"],
      "criar_arquivo": "base.py",
      "conteudo": "# EU MUDEI SO O TEXTO DO JSON E O AGENTE OBEDECEU\n"
    },
    {
      "id": "avisar_sobre_config",
      "pasta_com_conteudo": [".gitkeep", "base.py"],
      "criar_arquivo": "LEIA-ME.txt",
      "conteudo": "# NAO APAGUE base.py em config: ele e gerado pelo agente. Veja memoria/historico.json\n"
    }
  ]
}